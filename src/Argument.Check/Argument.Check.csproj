<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <PackageId>Argument.Check</PackageId>
        <Authors>Rene Peuser</Authors>
        <Company>Rene Peuser Softwaresolutions</Company>
        <Description>A library to check your arguments in a simple comfort way. This library do not use Expression or nameof. It is based on Func&lt;T&gt;. So no performance issue during positive argument check.</Description>
        <Copyright>Copyright 2019 (c) Rene Peuser. All rights reserved.</Copyright>
        <PackageLicenseFile></PackageLicenseFile>
        <PackageProjectUrl>https://renepeuser.visualstudio.com/Argument.Check</PackageProjectUrl>
        <RepositoryUrl>https://renepeuser.visualstudio.com/Argument.Check</RepositoryUrl>
        <PackageReleaseNotes>
            Changes:
            - Upgrade to Net8
        </PackageReleaseNotes>
        <PackageTags>C#;.Net;DotNet;Arg;Argument;ArgumentCheck;Argument.Check;Throw;Throw.If;Throw.IfNull;IfNull;IfExists;ThrowHelper;Contract;IsNull;</PackageTags>
        <PackageLicenseFile>license.txt</PackageLicenseFile>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <PackageReadmeFile>readme.md</PackageReadmeFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|netstandard2.0|AnyCPU'">
        <DocumentationFile>D:\AzureDevOps\Argument.Check\src\Argument.Check\Argument.Check.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
        <DocumentationFile>D:\AzureDevOps\Argument.Check\src\Argument.Check\Argument.Check.xml</DocumentationFile>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DocumentationFile>D:\AzureDevOps\Argument.Check\src\Argument.Check\Argument.Check.xml</DocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <None Include="..\..\license.txt">
            <Pack>True</Pack>
            <PackagePath></PackagePath>
        </None>
        <None Include="..\..\readme.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="GitVersion.MsBuild" Version="5.12.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

</Project>